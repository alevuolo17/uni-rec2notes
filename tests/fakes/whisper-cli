#!/usr/bin/env python3
"""Fake whisper-cli: takes its arguments only from a response file (`@file`, UTF-8, one per line, as rec2notes
passes them), needs the -f audio to exist, writes a fixed transcript to <-of>.json, shaped like `-oj` output,
and prints progress lines like `-pp`. FAKE_WHISPER_STOP_PARENT sends SIGTERM to its parent at 25%.
Every call appends its arguments, as a JSON line, to FAKE_WHISPER_LOG."""
import json
import os
import signal
import sys
import time

if len(sys.argv) != 2 or not sys.argv[1].startswith("@"):
    sys.exit(f"fake whisper-cli: expected only @file, got {sys.argv[1:]}")
with open(sys.argv[1][1:], "rb") as f:
    raw = f.read()
if b"\r" in raw:
    sys.exit("fake whisper-cli: the response file has a \\r, which whisper-cli would keep in the arguments")
args = raw.decode("utf-8").split("\n")[:-1]
if not os.path.exists(args[args.index("-f") + 1]):
    sys.exit(f"fake whisper-cli: no audio {args[args.index('-f') + 1]} in {os.getcwd()}")
with open(os.environ["FAKE_WHISPER_LOG"], "a") as f:
    f.write(json.dumps(args) + "\n")
segments = [(0, " prima frase"), (61_500, " seconda   frase"), (3_725_000, " terza frase"), (3_730_000, "  ")]
with open(args[args.index("-of") + 1] + ".json", "w") as f:
    json.dump({"transcription": [{"offsets": {"from": ms, "to": ms + 1000}, "text": text}
                                 for ms, text in segments]}, f)
for percent in range(5, 101, 5):  # like -pp; FAKE_WHISPER_DELAY slows it down for a manual look
    time.sleep(float(os.environ.get("FAKE_WHISPER_DELAY", 0)))
    print(f"whisper_print_progress_callback: progress = {percent:3d}%", file=sys.stderr, flush=True)
    if percent == 25 and os.environ.get("FAKE_WHISPER_STOP_PARENT"):
        with open(os.environ["FAKE_WHISPER_LOG"] + ".pid", "w") as f:
            f.write(str(os.getpid()))
        os.kill(os.getppid(), signal.SIGTERM)  # as if rec2notes were stopped halfway
        time.sleep(30)  # still "transcribing": rec2notes has to stop us, not wait
print("fake whisper-cli: done")
